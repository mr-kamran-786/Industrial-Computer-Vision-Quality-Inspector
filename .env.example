# Copy to .env and adjust. All variables are prefixed with ICVQI_.
# Values shown are the built-in defaults.

# --- App ---
ICVQI_ENVIRONMENT=development
ICVQI_APP_VERSION=2.0.0

# --- Database ---
# SQLite (default, local dev):
ICVQI_DATABASE_URL=sqlite:///backend/app/storage/database/inspections.db
# PostgreSQL (production) example:
# ICVQI_DATABASE_URL=postgresql+psycopg://icvqi:password@localhost:5432/icvqi

# --- Security ---
# Comma-separated API keys. LEAVE EMPTY ONLY FOR LOCAL DEV.
# In production set at least one strong key; clients send it as X-API-Key.
ICVQI_API_KEYS=
# Comma-separated allowed browser origins for CORS.
ICVQI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads ---
ICVQI_MAX_UPLOAD_BYTES=10485760

# --- Inference / decision policy ---
ICVQI_DEFAULT_MODEL_KEY=nano
ICVQI_IMAGE_SIZE=640
ICVQI_GLOBAL_CONFIDENCE_THRESHOLD=0.25
# Severities that force a FAIL verdict (comma-separated):
ICVQI_FAIL_SEVERITIES=critical,major
ICVQI_MAX_ACCEPTABLE_MINOR_DEFECTS=0
